# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Variable definition files (often contain sensitive data)
# *.tfvars
# *.tfvars.json

# Override files for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Optional: tfplan files to ignore plan output
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore terraform locks
.terraform.lock.hcl
